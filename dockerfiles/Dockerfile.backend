# syntax=docker/dockerfile:1.7

# ==============================================================================
# Multi-stage image for the AiiA Platform API (src/backend, uv project).
#
# The build context is the REPO ROOT (see compose.yaml):
#
#     docker build -f dockerfiles/Dockerfile.backend -t aiia-backend .
#
# Optimizations:
#   - uv slim image (Python + uv) only in the builder; runtime is python-slim.
#   - Layer caching: dependencies are installed from pyproject/uv.lock only
#     (bind mounts), so that layer is rebuilt only when a dependency changes,
#     never on a source-code change.
#   - Cache mount: uv's download/wheel cache persists across builds.
#   - Runtime gets just the venv + app/worker source: no uv, no build tools, no dev deps.
# ==============================================================================

ARG PYTHON_VERSION=3.12

# ---- Stage 1: builder (uv slim: Python + uv, nothing else) -------------------
FROM ghcr.io/astral-sh/uv:python${PYTHON_VERSION}-bookworm-slim AS builder

# Bytecode-compile for faster cold start; copy (not hardlink) out of the cache
# mount so the venv is self-contained; never download a Python interpreter.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app

# Dependency layer. The project is not installed as a package (tool.uv.package = false),
# so only third-party dependencies are synced; the source is copied in the runtime stage.
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    --mount=type=bind,source=src/backend/uv.lock,target=uv.lock \
    --mount=type=bind,source=src/backend/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-install-project


# ---- Stage 2: runtime (slim, no uv, no build tools) --------------------------
FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime

# Run as an unprivileged user.
RUN groupadd --system app && useradd --system --gid app --uid 1000 --create-home app

WORKDIR /app

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Venv first (changes rarely), then source (changes often) so a code change
# only rebuilds the last, small layer.
COPY --from=builder --chown=app:app /app/.venv /app/.venv
COPY --chown=app:app src/backend/app ./app
COPY --chown=app:app src/backend/worker ./worker

USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=5).status == 200 else 1)"]

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
