// AiiA — mô hình dữ liệu (DBML)
// Gồm 2 phần:
//   1) Schema `app`  : CSDL điều khiển (control plane) — PostgreSQL 18. Schema chạy được: aiia.sql
//   2) Schema `gold` : mô hình phân tích hồ sơ 360° — bảng Apache Iceberg, truy vấn qua Trino.
// Xem trực quan: dán vào https://dbdiagram.io

Project aiia {
  database_type: 'PostgreSQL'
  Note: '''
  Nền tảng Data Lakehouse hồ sơ 360° cho sinh viên, giảng viên, cán bộ.
  `app` lưu metadata vận hành: người dùng, nguồn, pipeline, catalog, DQ, đối soát danh tính,
  cấp quyền, dashboard, semantic model, cảnh báo, lineage, hỏi-đáp và audit.
  `gold` là lớp phân tích (Iceberg) — không lưu trong PostgreSQL.
  '''
}

// ───────────────────────── Enum (schema app) ─────────────────────────
Enum app.user_status {
  ACTIVE
  INACTIVE
}
Enum app.role_code {
  PLATFORM_ADMIN
  DATA_ENGINEER
  DATA_STEWARD
  BI_ANALYST
  REPORT_VIEWER
}
Enum app.org_unit_type {
  UNIVERSITY
  FACULTY
  DEPARTMENT
  OFFICE
  CENTER
}
Enum app.source_type {
  FILE
  JDBC
  API
}
Enum app.source_status {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}
Enum app.sensitivity_level {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}
Enum app.subject_type {
  STUDENT
  LECTURER
  STAFF
}
Enum app.run_trigger {
  MANUAL
  SCHEDULE
  RERUN
  REPROCESS
}
Enum app.run_status {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}
Enum app.data_layer {
  BRONZE
  SILVER
  GOLD
  QUARANTINE
}
Enum app.dq_rule_type {
  NOT_NULL
  UNIQUE
  RANGE
  REGEX
  REFERENCE
  FRESHNESS
  CUSTOM_SQL
}
Enum app.dq_dimension {
  COMPLETENESS
  UNIQUENESS
  VALIDITY
  CONSISTENCY
  TIMELINESS
}
Enum app.dq_severity {
  BLOCKING
  WARNING
}
Enum app.dq_rule_status {
  DRAFT
  ACTIVE
  DISABLED
}
Enum app.dq_result_status {
  PASS
  FAIL
  ERROR
}
Enum app.dq_issue_status {
  OPEN
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}
Enum app.match_status {
  PENDING
  AUTO_MERGED
  MERGED
  REJECTED
  UNMERGED
}
Enum app.merge_event_action {
  MERGE
  UNMERGE
}
Enum app.resource_type {
  DATASET
  DASHBOARD
  PROFILE_FACET
  METRIC
}
Enum app.access_level {
  READ
  EXPORT
}
Enum app.access_request_status {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  REVOKED
}
Enum app.dashboard_status {
  DRAFT
  PUBLISHED
  ARCHIVED
}
Enum app.principal_type {
  ROLE
  ORG_UNIT
  USER
}
Enum app.metric_status {
  DRAFT
  CERTIFIED
  DEPRECATED
}
Enum app.report_format {
  PDF
  LINK
}
Enum app.subscription_status {
  ACTIVE
  PAUSED
}
Enum app.delivery_status {
  SENT
  SKIPPED_NO_ACCESS
  FAILED
}
Enum app.detector_kind {
  VOLUME
  FRESHNESS
  METRIC_DRIFT
}
Enum app.alert_severity {
  LOW
  MEDIUM
  HIGH
}
Enum app.alert_status {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}
Enum app.lineage_node_type {
  SOURCE
  DATASET
  COLUMN
  METRIC
  DASHBOARD
}
Enum app.qa_role {
  USER
  ASSISTANT
}
Enum app.qa_status {
  ANSWERED
  CLARIFYING
  REFUSED
  FAILED
}
Enum app.audit_outcome {
  ALLOW
  DENY
}

// ───────────────────────── 1. Định danh & tổ chức ─────────────────────────
Table app.org_units {
  id bigserial [pk]
  code varchar(32) [unique, not null, note: 'Mã đơn vị, khớp với mã đơn vị ở SIS/HRM']
  name varchar(255) [not null]
  type app.org_unit_type [not null]
  parent_id bigint [ref: > app.org_units.id]
  is_active boolean [not null, default: true]
}

Table app.users {
  id uuid [pk, default: `gen_random_uuid()`]
  sso_subject varchar(255) [unique, not null, note: 'claim `sub` từ IdP (Keycloak)']
  email varchar(255) [unique, not null]
  full_name varchar(255) [not null]
  org_unit_id bigint [ref: > app.org_units.id]
  status app.user_status [not null, default: 'ACTIVE']
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table app.user_roles {
  id bigserial [pk]
  user_id uuid [not null, ref: > app.users.id]
  role_code app.role_code [not null]
  scope_org_unit_id bigint [ref: > app.org_units.id, note: 'NULL = toàn trường']
  granted_by uuid [ref: > app.users.id]
  granted_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, role_code, scope_org_unit_id) [unique]
  }
}

// ───────────────────────── 2. Nguồn & ingest ─────────────────────────
Table app.data_sources {
  id bigserial [pk]
  code varchar(32) [unique, not null, note: 'VD: SRC-SIS']
  name varchar(255) [not null]
  type app.source_type [not null]
  status app.source_status [not null, default: 'DRAFT']
  owner_user_id uuid [not null, ref: > app.users.id, note: 'Data Engineer phụ trách']
  business_owner varchar(255) [not null, note: 'Đơn vị/người chịu trách nhiệm nghiệp vụ']
  purpose text [not null, note: 'BR01 — mục đích sử dụng']
  legal_basis_ref varchar(255) [not null, note: 'BR01 — số văn bản/thỏa thuận chia sẻ']
  legal_doc_uri text
  sensitivity app.sensitivity_level [not null]
  subject_types "app.subject_type[]" [not null]
  connection_config jsonb [not null, default: '{}', note: 'Không chứa bí mật']
  secret_ref varchar(255) [note: 'Khóa tham chiếu secret store']
  file_template jsonb [note: 'Danh sách cột bắt buộc cho nguồn FILE']
  schedule_cron varchar(64)
  schedule_paused boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table app.ingestion_batches {
  id bigserial [pk]
  source_id bigint [not null, ref: > app.data_sources.id]
  file_name varchar(255)
  checksum_sha256 char(64) [not null]
  row_count integer
  bronze_path text [not null, note: 's3://lakehouse/bronze/...']
  uploaded_by uuid [ref: > app.users.id]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (source_id, checksum_sha256)
  }
}

Table app.pipeline_runs {
  id uuid [pk, default: `gen_random_uuid()`]
  source_id bigint [not null, ref: > app.data_sources.id]
  batch_id bigint [ref: > app.ingestion_batches.id]
  parent_run_id uuid [ref: > app.pipeline_runs.id, note: 'Run gốc khi chạy lại']
  trigger app.run_trigger [not null]
  status app.run_status [not null, default: 'QUEUED']
  orchestrator_run_id varchar(64) [note: 'Run id của Dagster']
  rows_read integer [not null, default: 0]
  rows_written integer [not null, default: 0]
  rows_quarantined integer [not null, default: 0]
  steps jsonb [not null, default: '[]', note: 'Bronze → DQ → Silver → Gold']
  error_message text
  triggered_by uuid [ref: > app.users.id]
  queued_at timestamptz [not null, default: `now()`]
  started_at timestamptz
  finished_at timestamptz
  indexes {
    (source_id, queued_at)
    status
  }
}

// ───────────────────────── 3. Catalog & glossary ─────────────────────────
Table app.glossary_terms {
  id bigserial [pk]
  name varchar(255) [unique, not null]
  definition text [not null]
  owner_user_id uuid [ref: > app.users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table app.datasets {
  id bigserial [pk]
  layer app.data_layer [not null]
  schema_name varchar(64) [not null]
  table_name varchar(128) [not null]
  display_name varchar(255) [not null]
  description text
  source_id bigint [ref: > app.data_sources.id]
  owner_user_id uuid [ref: > app.users.id]
  steward_user_id uuid [ref: > app.users.id, note: 'Steward phụ trách phê duyệt quyền (BR09)']
  freshness_sla_minutes integer [note: 'BR15']
  last_updated_at timestamptz
  row_count bigint
  dq_score numeric(5,2)
  tags "text[]" [not null, default: '{}']
  indexes {
    (layer, schema_name, table_name) [unique]
  }
}

Table app.dataset_columns {
  id bigserial [pk]
  dataset_id bigint [not null, ref: > app.datasets.id]
  name varchar(128) [not null]
  data_type varchar(64) [not null]
  ordinal smallint [not null]
  description text
  sensitivity app.sensitivity_level [not null, default: 'CONFIDENTIAL', note: 'BR07 — chưa phân loại = CONFIDENTIAL']
  glossary_term_id bigint [ref: > app.glossary_terms.id]
  indexes {
    (dataset_id, name) [unique]
  }
}

Table app.schema_mappings {
  id bigserial [pk]
  source_id bigint [not null, ref: > app.data_sources.id]
  target_dataset_id bigint [not null, ref: > app.datasets.id, note: 'Dataset Silver đích']
  version integer [not null]
  mapping jsonb [not null, note: '[{source_column, target_column, transform}]']
  is_active boolean [not null, default: false]
  created_by uuid [not null, ref: > app.users.id]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (source_id, target_dataset_id, version) [unique]
  }
}

// ───────────────────────── 4. Chất lượng dữ liệu ─────────────────────────
Table app.dq_rules {
  id bigserial [pk]
  dataset_id bigint [not null, ref: > app.datasets.id]
  column_id bigint [ref: > app.dataset_columns.id]
  rule_type app.dq_rule_type [not null]
  dimension app.dq_dimension [not null]
  severity app.dq_severity [not null]
  params jsonb [not null, default: '{}', note: 'VD: {min, max} / {pattern} / {ref_dataset, ref_column} / {sql}']
  description text [not null]
  status app.dq_rule_status [not null, default: 'DRAFT']
  version integer [not null, default: 1]
  created_by uuid [not null, ref: > app.users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table app.dq_rule_results {
  id bigserial [pk]
  rule_id bigint [not null, ref: > app.dq_rules.id]
  run_id uuid [not null, ref: > app.pipeline_runs.id]
  rule_version integer [not null]
  evaluated_count bigint [not null]
  failed_count bigint [not null]
  status app.dq_result_status [not null]
  sample_ref text [note: 'Đường dẫn mẫu bản ghi lỗi trong quarantine']
  evaluated_at timestamptz [not null, default: `now()`]
  indexes {
    (rule_id, evaluated_at)
    run_id
  }
}

Table app.dq_issues {
  id bigserial [pk]
  rule_id bigint [not null, ref: > app.dq_rules.id]
  dataset_id bigint [not null, ref: > app.datasets.id]
  first_run_id uuid [not null, ref: > app.pipeline_runs.id]
  last_run_id uuid [not null, ref: > app.pipeline_runs.id]
  affected_rows bigint [not null]
  severity app.dq_severity [not null]
  status app.dq_issue_status [not null, default: 'OPEN']
  assignee_id uuid [ref: > app.users.id]
  created_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz
  indexes {
    (status, dataset_id)
  }
}

Table app.dq_issue_comments {
  id bigserial [pk]
  issue_id bigint [not null, ref: > app.dq_issues.id]
  author_id uuid [not null, ref: > app.users.id]
  body text [not null]
  created_at timestamptz [not null, default: `now()`]
}

// ───────────────────────── 5. Đối soát danh tính ─────────────────────────
Table app.match_candidates {
  id bigserial [pk]
  left_source_code varchar(32) [not null]
  left_source_key varchar(128) [not null]
  right_source_code varchar(32) [not null]
  right_source_key varchar(128) [not null]
  left_person_id uuid [not null, note: 'gold.dim_person.person_id']
  right_person_id uuid [not null]
  score numeric(4,3) [not null, note: 'BR05: ≥0,95 tự gộp; 0,75–0,95 chờ duyệt']
  feature_scores jsonb [not null, note: 'Điểm từng trường; trường RESTRICTED chỉ lưu khớp/không khớp']
  status app.match_status [not null, default: 'PENDING']
  decided_by uuid [ref: > app.users.id]
  decided_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (left_source_code, left_source_key, right_source_code, right_source_key) [unique]
    (status, score)
  }
}

Table app.person_merge_events {
  id bigserial [pk]
  action app.merge_event_action [not null]
  survivor_person_id uuid [not null]
  merged_person_id uuid [not null]
  candidate_id bigint [ref: > app.match_candidates.id]
  actor_id uuid [ref: > app.users.id, note: 'NULL = gộp tự động']
  snapshot jsonb [not null, note: 'Trạng thái trước thao tác để có thể tách lại']
  created_at timestamptz [not null, default: `now()`]
}

// ───────────────────────── 6. Cấp quyền & chính sách ─────────────────────────
Table app.access_requests {
  id bigserial [pk]
  requester_id uuid [not null, ref: > app.users.id]
  resource_type app.resource_type [not null]
  resource_id varchar(128) [not null, note: 'id dataset/dashboard/metric hoặc mã facet hồ sơ']
  access_level app.access_level [not null, default: 'READ']
  purpose text [not null]
  scope jsonb [not null, default: '{}', note: 'VD: {org_unit_ids: [..]}']
  requested_days smallint [not null, note: '1..180 (BR09)']
  status app.access_request_status [not null, default: 'PENDING']
  reviewer_id uuid [ref: > app.users.id]
  review_note text
  decided_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (status, resource_type, resource_id)
    requester_id
  }
}

Table app.access_grants {
  id bigserial [pk]
  user_id uuid [not null, ref: > app.users.id]
  resource_type app.resource_type [not null]
  resource_id varchar(128) [not null]
  access_level app.access_level [not null]
  scope jsonb [not null, default: '{}']
  request_id bigint [ref: > app.access_requests.id]
  granted_by uuid [not null, ref: > app.users.id]
  valid_from timestamptz [not null, default: `now()`]
  valid_to timestamptz [not null]
  revoked_at timestamptz
  indexes {
    (user_id, resource_type, resource_id)
    valid_to
  }
}

Table app.access_policies {
  id bigserial [pk]
  name varchar(255) [unique, not null]
  dataset_id bigint [not null, ref: > app.datasets.id]
  role_code app.role_code [not null]
  current_version integer [not null, default: 1]
  is_active boolean [not null, default: true]
  created_by uuid [not null, ref: > app.users.id]
  created_at timestamptz [not null, default: `now()`]
}

Table app.access_policy_versions {
  policy_id bigint [ref: > app.access_policies.id]
  version integer
  row_filter text [note: "Biểu thức Trino, VD: faculty_code = current_user_attr('faculty_code')"]
  column_rules jsonb [not null, default: '[]', note: '[{column, action: MASK_PARTIAL|HASH|DENY}]']
  change_note text
  created_by uuid [not null, ref: > app.users.id]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (policy_id, version) [pk]
  }
}

// ───────────────────────── 7. BI & semantic model ─────────────────────────
Table app.semantic_dimensions {
  id bigserial [pk]
  code varchar(64) [unique, not null, note: 'VD: academic_year, faculty']
  name varchar(255) [not null]
  dataset_id bigint [not null, ref: > app.datasets.id]
  column_name varchar(128) [not null]
  description text
}

Table app.semantic_metrics {
  id bigserial [pk]
  code varchar(64) [unique, not null, note: 'VD: academic_warning_rate']
  name varchar(255) [not null]
  definition text [not null, note: 'Định nghĩa nghiệp vụ']
  expression text [not null, note: 'Biểu thức SQL tổng hợp']
  base_dataset_id bigint [not null, ref: > app.datasets.id]
  allowed_dimensions "text[]" [not null, default: '{}']
  unit varchar(32)
  owner_id uuid [not null, ref: > app.users.id]
  glossary_term_id bigint [ref: > app.glossary_terms.id]
  status app.metric_status [not null, default: 'DRAFT']
  version integer [not null, default: 1]
  certified_by uuid [ref: > app.users.id]
  certified_at timestamptz
  updated_at timestamptz [not null, default: `now()`]
}

Table app.semantic_metric_versions {
  metric_id bigint [ref: > app.semantic_metrics.id]
  version integer
  expression text [not null]
  definition text [not null]
  changed_by uuid [not null, ref: > app.users.id]
  changed_at timestamptz [not null, default: `now()`]
  indexes {
    (metric_id, version) [pk]
  }
}

Table app.dashboards {
  id bigserial [pk]
  title varchar(255) [not null]
  description text
  topic varchar(64) [not null, note: 'TRAINING | HR | RESEARCH | FINANCE | DATA_QUALITY']
  owner_id uuid [not null, ref: > app.users.id]
  status app.dashboard_status [not null, default: 'DRAFT']
  global_filters jsonb [not null, default: '[]']
  version integer [not null, default: 1]
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table app.dashboard_widgets {
  id bigserial [pk]
  dashboard_id bigint [not null, ref: > app.dashboards.id]
  type varchar(32) [not null, note: 'KPI | BAR | LINE | PIE | HEATMAP | TABLE']
  title varchar(255) [not null]
  query_spec jsonb [not null, note: 'SemanticQuery: metrics, dimensions, filters, drill_path']
  position jsonb [not null, note: '{x, y, w, h}']
}

Table app.dashboard_shares {
  dashboard_id bigint [ref: > app.dashboards.id]
  principal_type app.principal_type
  principal_id varchar(128)
  indexes {
    (dashboard_id, principal_type, principal_id) [pk]
  }
}

Table app.dashboard_favorites {
  user_id uuid [ref: > app.users.id]
  dashboard_id bigint [ref: > app.dashboards.id]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, dashboard_id) [pk]
  }
}

Table app.report_subscriptions {
  id bigserial [pk]
  dashboard_id bigint [not null, ref: > app.dashboards.id]
  owner_id uuid [not null, ref: > app.users.id]
  cron varchar(64) [not null]
  format app.report_format [not null, default: 'PDF']
  filters jsonb [not null, default: '{}']
  include_ai_summary boolean [not null, default: true]
  status app.subscription_status [not null, default: 'ACTIVE']
  next_run_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table app.subscription_recipients {
  subscription_id bigint [ref: > app.report_subscriptions.id]
  user_id uuid [ref: > app.users.id, note: 'Chỉ người dùng nội bộ (BR18)']
  indexes {
    (subscription_id, user_id) [pk]
  }
}

Table app.report_deliveries {
  id bigserial [pk]
  subscription_id bigint [not null, ref: > app.report_subscriptions.id]
  recipient_id uuid [not null, ref: > app.users.id]
  status app.delivery_status [not null]
  artifact_uri text
  ai_summary text
  error_message text
  sent_at timestamptz [not null, default: `now()`]
}

// ───────────────────────── 8. Bất thường & lineage ─────────────────────────
Table app.anomaly_detectors {
  id bigserial [pk]
  kind app.detector_kind [not null]
  dataset_id bigint [ref: > app.datasets.id]
  metric_id bigint [ref: > app.semantic_metrics.id]
  params jsonb [not null, default: '{}', note: 'VD: {window: 4, pct: 0.3} / {sigma: 3}']
  enabled boolean [not null, default: true]
  Note: 'Đúng một trong dataset_id / metric_id khác NULL'
}

Table app.anomaly_alerts {
  id bigserial [pk]
  detector_id bigint [not null, ref: > app.anomaly_detectors.id]
  run_id uuid [ref: > app.pipeline_runs.id]
  observed_value numeric [not null]
  expected_low numeric
  expected_high numeric
  severity app.alert_severity [not null]
  status app.alert_status [not null, default: 'OPEN']
  note text
  detected_at timestamptz [not null, default: `now()`]
  acknowledged_by uuid [ref: > app.users.id]
  acknowledged_at timestamptz
  closed_at timestamptz
  indexes {
    (status, detected_at)
  }
}

Table app.lineage_nodes {
  id bigserial [pk]
  node_type app.lineage_node_type [not null]
  ref_id varchar(128) [not null, note: 'id/mã đối tượng tương ứng']
  name varchar(255) [not null]
  indexes {
    (node_type, ref_id) [unique]
  }
}

Table app.lineage_edges {
  id bigserial [pk]
  from_node_id bigint [not null, ref: > app.lineage_nodes.id]
  to_node_id bigint [not null, ref: > app.lineage_nodes.id]
  transform_ref varchar(255) [note: 'dbt model / Dagster asset']
  observed_at timestamptz [not null, default: `now()`]
  indexes {
    (from_node_id, to_node_id) [unique]
    to_node_id
  }
}

// ───────────────────────── 9. Hỏi-đáp, thông báo, audit ─────────────────────────
Table app.qa_conversations {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > app.users.id]
  title varchar(255)
  created_at timestamptz [not null, default: `now()`]
}

Table app.qa_messages {
  id bigserial [pk]
  conversation_id uuid [not null, ref: > app.qa_conversations.id]
  role app.qa_role [not null]
  content text [not null]
  status app.qa_status [note: 'Chỉ với role = ASSISTANT']
  semantic_query jsonb [note: 'Truy vấn có cấu trúc do LLM đề xuất']
  compiled_sql text
  metric_codes "text[]" [not null, default: '{}']
  data_as_of timestamptz
  refusal_reason varchar(64)
  model varchar(64)
  latency_ms integer
  feedback smallint [note: '1 hữu ích, -1 không hữu ích']
  created_at timestamptz [not null, default: `now()`]
}

Table app.qa_blocked_topics {
  id bigserial [pk]
  pattern varchar(255) [not null]
  description text
  created_by uuid [not null, ref: > app.users.id]
  created_at timestamptz [not null, default: `now()`]
}

Table app.notifications {
  id bigserial [pk]
  user_id uuid [not null, ref: > app.users.id]
  type varchar(64) [not null]
  title varchar(255) [not null]
  link text
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, read_at)
  }
}

Table app.audit_logs {
  id bigserial
  occurred_at timestamptz [not null, default: `now()`]
  actor_id uuid [ref: > app.users.id]
  action varchar(64) [not null, note: 'VD: PROFILE_VIEW, EXPORT, GRANT_CHANGE, QA_ASK']
  object_type varchar(64) [not null]
  object_id varchar(128)
  outcome app.audit_outcome [not null]
  ip inet
  details jsonb [not null, default: '{}']
  indexes {
    (id, occurred_at) [pk]
    (actor_id, occurred_at)
    (object_type, object_id)
  }
  Note: 'Phân vùng theo tháng; trigger chặn UPDATE/DELETE (BR10)'
}

// ═════════════════════════ Lớp Gold (Apache Iceberg) ═════════════════════════
// Cột ghi chú [S:...] = mức nhạy cảm mặc định (PUBLIC/INTERNAL/CONFIDENTIAL/RESTRICTED).

Table gold.dim_org_unit {
  org_unit_code varchar [pk]
  name varchar
  type varchar
  parent_code varchar [ref: > gold.dim_org_unit.org_unit_code]
}

Table gold.dim_term {
  term_code varchar [pk, note: 'VD: 2025-2026-HK1']
  academic_year varchar
  semester smallint
  start_date date
  end_date date
}

Table gold.dim_program {
  program_code varchar [pk]
  name varchar
  level varchar [note: 'DAI_HOC | THAC_SI | TIEN_SI']
  faculty_code varchar [ref: > gold.dim_org_unit.org_unit_code]
  total_credits smallint
}

Table gold.dim_course {
  course_code varchar [pk]
  name varchar
  credits smallint
  faculty_code varchar [ref: > gold.dim_org_unit.org_unit_code]
}

Table gold.dim_person {
  person_id uuid [pk, note: 'Golden record (BR06)']
  full_name varchar [note: 'S:INTERNAL']
  date_of_birth date [note: 'S:RESTRICTED']
  gender varchar [note: 'S:CONFIDENTIAL']
  email varchar [note: 'S:INTERNAL']
  phone varchar [note: 'S:CONFIDENTIAL']
  national_id_hash varchar [note: 'S:RESTRICTED — chỉ lưu băm có salt']
  primary_org_unit_code varchar [ref: > gold.dim_org_unit.org_unit_code]
  roles "array<varchar>" [note: 'STUDENT, LECTURER, STAFF']
  completeness_score decimal
  updated_at timestamp
}

Table gold.person_source_xref {
  person_id uuid [ref: > gold.dim_person.person_id]
  source_code varchar
  source_key varchar
  match_method varchar [note: 'DETERMINISTIC | PROBABILISTIC | MANUAL']
  match_score decimal
  valid_from timestamp
  valid_to timestamp
  indexes {
    (source_code, source_key) [pk]
  }
}

Table gold.person_attribute_provenance {
  person_id uuid [ref: > gold.dim_person.person_id]
  attribute varchar
  value_source varchar [note: 'Nguồn thắng theo survivorship']
  source_updated_at timestamp
  survivorship_rule varchar
  candidates "array<struct>" [note: 'Giá trị từ từng nguồn (BR04)']
  indexes {
    (person_id, attribute) [pk]
  }
}

Table gold.dim_student {
  student_id varchar [pk, note: 'Mã sinh viên']
  person_id uuid [ref: > gold.dim_person.person_id]
  program_code varchar [ref: > gold.dim_program.program_code]
  faculty_code varchar [ref: > gold.dim_org_unit.org_unit_code]
  cohort varchar [note: 'Khóa, VD: K66']
  class_code varchar
  status varchar [note: 'STUDYING | RESERVED | SUSPENDED | GRADUATED | DROPPED']
  admission_date date
  expected_graduation_date date
}

Table gold.dim_lecturer {
  lecturer_id varchar [pk]
  person_id uuid [ref: > gold.dim_person.person_id]
  faculty_code varchar [ref: > gold.dim_org_unit.org_unit_code]
  academic_title varchar [note: 'GS | PGS | NULL']
  degree varchar [note: 'TS | ThS | CN']
  employment_type varchar
}

Table gold.dim_staff {
  staff_id varchar [pk]
  person_id uuid [ref: > gold.dim_person.person_id]
  org_unit_code varchar [ref: > gold.dim_org_unit.org_unit_code]
  position varchar
  grade varchar [note: 'Ngạch/bậc — S:CONFIDENTIAL']
  contract_type varchar
  start_date date
}

Table gold.fact_enrollment {
  student_id varchar [ref: > gold.dim_student.student_id]
  term_code varchar [ref: > gold.dim_term.term_code]
  course_code varchar [ref: > gold.dim_course.course_code]
  class_section varchar
  credits smallint
  score_10 decimal [note: 'S:CONFIDENTIAL']
  score_4 decimal
  letter_grade varchar
  passed boolean
}

Table gold.fact_term_result {
  student_id varchar [ref: > gold.dim_student.student_id]
  term_code varchar [ref: > gold.dim_term.term_code]
  gpa_term decimal [note: 'S:CONFIDENTIAL']
  gpa_cumulative decimal [note: 'S:CONFIDENTIAL']
  credits_earned smallint
  academic_warning_level smallint [note: '0 = không cảnh báo; S:CONFIDENTIAL']
  conduct_score smallint [note: 'Điểm rèn luyện']
  indexes {
    (student_id, term_code) [pk]
  }
}

Table gold.fact_tuition {
  student_id varchar [ref: > gold.dim_student.student_id]
  term_code varchar [ref: > gold.dim_term.term_code]
  amount_due decimal [note: 'S:CONFIDENTIAL']
  amount_paid decimal [note: 'S:CONFIDENTIAL']
  scholarship_amount decimal [note: 'S:CONFIDENTIAL']
  waiver_amount decimal [note: 'S:CONFIDENTIAL']
  payment_status varchar [note: 'PAID | PARTIAL | UNPAID']
  indexes {
    (student_id, term_code) [pk]
  }
}

Table gold.fact_lms_activity_daily {
  person_id uuid [ref: > gold.dim_person.person_id]
  activity_date date
  course_code varchar [ref: > gold.dim_course.course_code]
  logins integer
  submissions integer
  active_minutes integer
}

Table gold.fact_library_loan {
  person_id uuid [ref: > gold.dim_person.person_id]
  loan_date date
  item_type varchar
  loans integer
}

Table gold.fact_teaching_load {
  lecturer_id varchar [ref: > gold.dim_lecturer.lecturer_id]
  term_code varchar [ref: > gold.dim_term.term_code]
  course_code varchar [ref: > gold.dim_course.course_code]
  sections smallint
  teaching_hours decimal
}

Table gold.fact_teaching_evaluation {
  lecturer_id varchar [ref: > gold.dim_lecturer.lecturer_id]
  term_code varchar [ref: > gold.dim_term.term_code]
  course_code varchar [ref: > gold.dim_course.course_code]
  responses integer [note: 'Ẩn khi < 5 (BR12)']
  avg_score decimal [note: 'S:CONFIDENTIAL']
}

Table gold.fact_research_output {
  person_id uuid [ref: > gold.dim_person.person_id]
  output_type varchar [note: 'PUBLICATION | PROJECT | SUPERVISION']
  title varchar
  year smallint
  level varchar [note: 'ISI/Scopus, cấp Bộ, cấp trường...']
  role varchar
}

Table gold.fact_award_discipline {
  person_id uuid [ref: > gold.dim_person.person_id]
  kind varchar [note: 'AWARD | DISCIPLINE — DISCIPLINE là S:RESTRICTED']
  level varchar
  decision_ref varchar
  decision_date date
}

Table gold.fact_profile_event {
  event_id varchar [pk]
  person_id uuid [ref: > gold.dim_person.person_id]
  event_time timestamp
  event_type varchar [note: 'ADMISSION, ENROLL, TUITION_PAID, AWARD, PUBLICATION...']
  facet varchar [note: 'Tab hồ sơ chứa sự kiện — dùng để lọc theo quyền (AC15)']
  source_code varchar
  title varchar
  sensitivity varchar
}

Table gold.mart_student_term_kpi {
  term_code varchar [ref: > gold.dim_term.term_code]
  faculty_code varchar [ref: > gold.dim_org_unit.org_unit_code]
  program_code varchar [ref: > gold.dim_program.program_code]
  cohort varchar
  n_students integer
  n_academic_warning integer
  n_dropped integer
  n_graduated_on_time integer
  avg_gpa_term decimal
  Note: 'Mart tổng hợp cho dashboard Đào tạo và semantic model'
}
