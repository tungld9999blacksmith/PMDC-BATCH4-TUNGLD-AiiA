# syntax=docker/dockerfile:1.7

# ==============================================================================
# Multi-stage image for the AiiA Web App (src/frontend, Angular 19 standalone).
# Build stage: Node + npm ci. Runtime: nginx serving the static bundle and
# proxying /api to the Platform API.
#
#     docker build -f dockerfiles/Dockerfile.web -t aiia-web .
# ==============================================================================

ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-alpine AS build
WORKDIR /app

# Dependency layer: chỉ thay đổi khi package.json (hoặc lockfile) thay đổi.
COPY src/frontend/package.json src/frontend/package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi

COPY src/frontend/ ./
RUN npx ng build --configuration production


FROM nginx:1.27-alpine AS runtime

COPY src/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/aiia-web/browser /usr/share/nginx/html

EXPOSE 80
